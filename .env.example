# Supabase (server-only — service role key, never expose client-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel auth
# Generate a long random string, e.g.: openssl rand -base64 32
ADMIN_JWT_SECRET=

# Anthropic API key, used by the /api/chat assistant
ANTHROPIC_API_KEY=

# Public site URL, used for canonical links, Open Graph, and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://www.taxesigroup.com
